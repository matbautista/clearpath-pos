# Copy this file to .env and adjust as needed.

# Port the local server listens on
PORT=4000

# Random long string used to sign session cookies. Change this.
SESSION_SECRET=change-this-to-a-random-string

# Optional: SMTP settings for emailing digital receipts.
# Leave blank to disable email receipts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Clear Path POS <receipts@example.com>"

# Optional: SMS receipts require a third-party SMS provider (e.g. Twilio, Semaphore).
# Not wired up by default since it requires a paid account. See README for notes.
